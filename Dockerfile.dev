FROM node:22-alpine

WORKDIR /app

# Enable Corepack for Yarn
RUN corepack enable

# Install required system dependencies
RUN apk add --no-cache python3 make g++ git postgresql-client redis

# Copy everything
COPY . .

# Install dependencies
RUN yarn install

# Patch the dev server proxy to point to the affine-server container
RUN sed -i "s/http:\/\/localhost:3010/http:\/\/affine-server:3010/g" tools/cli/src/bundle-shared.ts

# Generate Prisma client
RUN yarn workspace @affine/server postinstall

# Make entrypoint executable
RUN chmod +x docker-entrypoint.sh

# Expose the ports for web and server
EXPOSE 8080 3010

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["yarn", "dev"]
